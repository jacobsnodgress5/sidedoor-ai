# ==============================================================================
# NetWeave AI: Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in your API keys.
# You can also configure your keys directly inside the NetWeave AI web interface!

# 1. Google Gemini API Key (Required for AI Copywriting & Resume Parsing)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Hunter.io API Key (Required for verified company email sourcing)
# Get a free account (25 searches/month) at: https://hunter.io/api
HUNTER_API_KEY=your_hunter_api_key_here

# 3. Optional Enrichment Services (Advanced)
APOLLO_API_KEY=
PROXYCURL_API_KEY=
TAVILY_API_KEY=
